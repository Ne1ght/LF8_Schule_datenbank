digraph ER {
    graph [rankdir=LR];
    "BILDUNGSGANG" [shape=none, label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#BBDEFB"><b>BILDUNGSGANG</b></td></tr><tr><td><u>BILDUNGSGANG_ID</u></td></tr><tr><td>BEZEICHNUNG</td></tr></table>>];
    "FACHRICHTUNG" [shape=none, label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#BBDEFB"><b>FACHRICHTUNG</b></td></tr><tr><td><u>FACHRICHTUNG_ID</u></td></tr><tr><td>BEZEICHNUNG</td></tr></table>>];
    "KLASSE" [shape=none, label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#BBDEFB"><b>KLASSE</b></td></tr><tr><td><u>KLASSEN_ID</u></td></tr><tr><td>KLASSENNAME</td></tr><tr><td>bildungsgang_id</td></tr><tr><td>klassenlehrer_id</td></tr></table>>];
    "KLASSE_FACH" [shape=none, label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#BBDEFB"><b>KLASSE_FACH</b></td></tr><tr><td>KLASSEN_ID</td></tr><tr><td>FACH_ID</td></tr><tr><td>LEHRER_ID</td></tr></table>>];
    "LEHRER" [shape=none, label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#BBDEFB"><b>LEHRER</b></td></tr><tr><td><u>LEHRER_ID</u></td></tr><tr><td>VORNAME</td></tr><tr><td>NACHNAME</td></tr><tr><td>ERSTFACH_ID</td></tr><tr><td>ZWEITFACH_ID</td></tr></table>>];
    "SCHUELER" [shape=none, label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#BBDEFB"><b>SCHUELER</b></td></tr><tr><td><u>SCHUELER_ID</u></td></tr><tr><td>VORNAME</td></tr><tr><td>NACHNAME</td></tr><tr><td>KLASSEN_ID</td></tr></table>>];
    "UNTERRICHTSFACH" [shape=none, label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#BBDEFB"><b>UNTERRICHTSFACH</b></td></tr><tr><td><u>FACH_ID</u></td></tr><tr><td>BEZEICHNUNG</td></tr><tr><td>FACHRICHTUNG_ID</td></tr></table>>];
    "BILDUNGSGANG" -> "KLASSE" [label="bildungsgang_id", arrowhead=crow, arrowtail=none, dir=both];
    "LEHRER" -> "KLASSE" [label="klassenlehrer_id", arrowhead=crow, arrowtail=none, dir=both];
    "KLASSE" -> "KLASSE_FACH" [label="KLASSEN_ID", arrowhead=crow, arrowtail=none, dir=both];
    "FACHRICHTUNG" -> "KLASSE_FACH" [label="FACH_ID", arrowhead=crow, arrowtail=none, dir=both];
    "LEHRER" -> "KLASSE_FACH" [label="LEHRER_ID", arrowhead=crow, arrowtail=none, dir=both];
    "FACHRICHTUNG" -> "LEHRER" [label="ERSTFACH_ID", arrowhead=crow, arrowtail=none, dir=both];
    "KLASSE" -> "SCHUELER" [label="KLASSEN_ID", arrowhead=crow, arrowtail=none, dir=both];
    "FACHRICHTUNG" -> "UNTERRICHTSFACH" [label="FACHRICHTUNG_ID", arrowhead=crow, arrowtail=none, dir=both];
}